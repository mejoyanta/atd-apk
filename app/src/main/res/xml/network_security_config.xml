<?xml version="1.0" encoding="utf-8"?>
<!-- Office kiosk: cleartext allowed for LAN ERP (http://ip:port). Prefer HTTPS when TLS is available. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
